# Скопируйте в .env и поправьте пути (относительно папки с docker-compose.yml).
# Папка ML-части (там Dockerfile.worker, ml/, out/cache/)
ML_DIR=./ml-service
# Документы и метаданные пакета организаторов: 01_ДОКУМЕНТАЦИЯ и 02_ФОРМАТ_ДАННЫХ_И_ПРИМЕРЫ/data.
# Без них сервис тоже работает — объекты создаются и документы загружаются через интерфейс.
PACKAGE_DOCS=./data/package/docs
PACKAGE_DATA=./data/package/data
# Готовые ответы ML (submission_*.json, integrity_*.json) — импортируются как первая версия протокола
SEED_RESULTS=./ml-service/out
# Секрет подписи токенов (пусто — сгенерируется при первом запуске) и пароли учётных записей стенда
JWT_SECRET=
PASS_INSPECTOR=inspector
PASS_SUPERVISOR=supervisor
PASS_ADMIN=admin
PASS_ML=ml
RABBITMQ_USER=inspector
RABBITMQ_PASS=inspector
